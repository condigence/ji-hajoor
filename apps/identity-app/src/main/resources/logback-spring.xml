<?xml version="1.0" encoding="UTF-8"?>
<!--
  identity-app logging. The services in this JVM share one logging system, so the service name on each
  line is the deployable's; the logger name (com.jihajoor.<service>...) says which service wrote it.
-->
<configuration>
    <property name="SERVICE_NAME" value="identity-app"/>
    <include resource="logback-json-base.xml"/>
    <root level="INFO">
        <appender-ref ref="JSON_STDOUT"/>
    </root>
</configuration>
