<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jihajoor</groupId>
        <artifactId>jihajoor-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>com.jihajoor</groupId>
    <artifactId>rating-review-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Ji-Hajoor Rating &amp; Review Service</name>
    <description>
        Review submission with review-window enforcement (7-day prompt), integer 1-5 ratings on
        five dimensions with optional text and photo attachments, weighted aggregate recalculation
        (1.5x for reviews within 90 days, 1.0x otherwise, rounded to 2 dp), fraud detection
        (same-IP burst, star-rating deviation > 2 SD, freshly-created accounts) with flagged
        reviews held out of the aggregate until Admin approval, ReviewSubmitted event publishing
        via the shared outbox, automatic UNDER_REVIEW flagging when the aggregate drops below 3.0,
        and Admin moderation with Audit_Log entries (Requirement 15). Built on the shared security,
        observability, and outbox libraries (Tasks 4-6) and consumes the Payment Service's
        PaymentCompleted event (Task 18).
    </description>

    <dependencies>
        <!-- ===== Ji-Hajoor shared libraries (Tasks 4-6) ===== -->
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-resilience</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-outbox</artifactId>
        </dependency>
        <!-- Settings from the config.app_config table. -->
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-config</artifactId>
        </dependency>

        <!-- ===== Spring Boot starters ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <!-- Schema migrations: src/main/resources/db/migration/rating-review-service (V1 = baseline). -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- PostgreSQL support is a module of its own since Flyway 10. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== Runtime persistence driver ===== -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Micrometer Prometheus registry for /metrics (Requirement 25.4) ===== -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Test dependencies ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- jqwik for property-based tests (Testing Strategy: Property-Based Tests) -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
