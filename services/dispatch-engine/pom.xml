<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jihajoor</groupId>
        <artifactId>jihajoor-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>com.jihajoor</groupId>
    <artifactId>dispatch-engine</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Ji-Hajoor Dispatch Engine</name>
    <description>
        Provider matching and job-offer dispatch: consumes BookingCreated, scores eligible
        providers with a configurable weighted formula, sends sequential job offers guarded by
        an exclusive Redis lock, expands the search radius when no provider accepts, and drives
        the booking to PROVIDER_ACCEPTED or SEARCHING_FAILED (Requirements 8.2-8.11, 19.5, 24.5).
        A dedicated bulkhead thread pool isolates emergency dispatch from scheduled dispatch.
        Built on the shared security, observability, and outbox libraries (Tasks 4-6).
    </description>

    <dependencies>
        <!-- ===== Ji-Hajoor shared libraries (Tasks 4-6) ===== -->
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-resilience</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-outbox</artifactId>
        </dependency>
        <!-- Settings from the config.app_config table. -->
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-config</artifactId>
        </dependency>

        <!-- ===== Spring Boot starters ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <!-- Schema migrations: src/main/resources/db/migration/dispatch-engine (V1 = baseline). -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- PostgreSQL support is a module of its own since Flyway 10. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== Redis: exclusive per-provider offer lock (Requirement 8.11) ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ===== Kafka: BookingCreated consumption + ProviderAccepted relay ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!-- ===== Runtime persistence driver ===== -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Micrometer Prometheus registry for /metrics (Requirement 25.4) ===== -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Test dependencies ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-memory DB for repository/integration slice tests -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- jqwik for property-based tests (Testing Strategy: Property-Based Tests) -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ===== Pact provider verification (Task 46) =====
             The Dispatch Engine is the message PROVIDER: it verifies it can consume the
             BookingCreated message described by the Booking Service consumer contract.
             junit5 supplies the MessagePactVerifier support (no HTTP target needed). -->
        <dependency>
            <groupId>au.com.dius.pact.provider</groupId>
            <artifactId>junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!-- JaCoCo coverage report (aligned with shared modules) -->
        </plugins>
    </build>
</project>
