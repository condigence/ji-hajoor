<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.homefix</groupId>
    <artifactId>dispatch-engine</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>HomeFix Dispatch Engine</name>
    <description>
        Provider matching and job-offer dispatch: consumes BookingCreated, scores eligible
        providers with a configurable weighted formula, sends sequential job offers guarded by
        an exclusive Redis lock, expands the search radius when no provider accepts, and drives
        the booking to PROVIDER_ACCEPTED or SEARCHING_FAILED (Requirements 8.2-8.11, 19.5, 24.5).
        A dedicated bulkhead thread pool isolates emergency dispatch from scheduled dispatch.
        Built on the shared security, observability, and outbox libraries (Tasks 4-6).
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions (aligned with shared modules and the sibling services) -->
        <spring-boot.version>3.2.5</spring-boot.version>
        <homefix-shared.version>1.0.0-SNAPSHOT</homefix-shared.version>
        <jacoco.version>0.8.12</jacoco.version>
        <jqwik.version>1.8.4</jqwik.version>
        <pact.version>4.6.21</pact.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ===== HomeFix shared libraries (Tasks 4-6) ===== -->
        <dependency>
            <groupId>com.homefix.shared</groupId>
            <artifactId>homefix-shared-security</artifactId>
            <version>${homefix-shared.version}</version>
        </dependency>
        <dependency>
            <groupId>com.homefix.shared</groupId>
            <artifactId>homefix-shared-observability</artifactId>
            <version>${homefix-shared.version}</version>
        </dependency>
        <dependency>
            <groupId>com.homefix.shared</groupId>
            <artifactId>homefix-shared-resilience</artifactId>
            <version>${homefix-shared.version}</version>
        </dependency>
        <dependency>
            <groupId>com.homefix.shared</groupId>
            <artifactId>homefix-shared-outbox</artifactId>
            <version>${homefix-shared.version}</version>
        </dependency>

        <!-- ===== Spring Boot starters ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <!-- Schema migrations: src/main/resources/db/migration (V1 = baseline). -->
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== Redis: exclusive per-provider offer lock (Requirement 8.11) ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ===== Kafka: BookingCreated consumption + ProviderAccepted relay ===== -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- ===== Runtime persistence driver ===== -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Micrometer Prometheus registry for /metrics (Requirement 25.4) ===== -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Test dependencies ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-memory DB for repository/integration slice tests -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- jqwik for property-based tests (Testing Strategy: Property-Based Tests) -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ===== Pact provider verification (Task 46) =====
             The Dispatch Engine is the message PROVIDER: it verifies it can consume the
             BookingCreated message described by the Booking Service consumer contract.
             junit5 supplies the MessagePactVerifier support (no HTTP target needed). -->
        <dependency>
            <groupId>au.com.dius.pact.provider</groupId>
            <artifactId>junit5</artifactId>
            <version>${pact.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                    <!-- Retain parameter names in the bytecode. Spring resolves an unnamed
                         @PathVariable/@RequestParam by reflecting on the parameter name, which
                         javac drops without this; these services import the Spring Boot BOM but
                         do not inherit spring-boot-starter-parent, which is what would otherwise
                         set it. Without it such a handler fails at request time with a 500. -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- JaCoCo coverage report (aligned with shared modules) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
