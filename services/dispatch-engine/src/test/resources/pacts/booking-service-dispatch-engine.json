{
  "consumer": {
    "name": "booking-service"
  },
  "messages": [
    {
      "contents": {
        "bookingId": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
        "customerId": "e2490de5-5bd3-43d5-b7c4-526e33f71304",
        "customerLat": 12.9716,
        "customerLon": 77.5946,
        "emergency": false,
        "requiredSkillTags": [
          "plumbing"
        ],
        "subcategoryId": "e2490de5-5bd3-43d5-b7c4-526e33f71304"
      },
      "description": "a BookingCreated event",
      "generators": {
        "body": {
          "$.bookingId": {
            "type": "Uuid"
          },
          "$.customerId": {
            "type": "Uuid"
          },
          "$.subcategoryId": {
            "type": "Uuid"
          }
        }
      },
      "matchingRules": {
        "body": {
          "$.bookingId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
              }
            ]
          },
          "$.customerId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
              }
            ]
          },
          "$.customerLat": {
            "combine": "AND",
            "matchers": [
              {
                "match": "number"
              }
            ]
          },
          "$.customerLon": {
            "combine": "AND",
            "matchers": [
              {
                "match": "number"
              }
            ]
          },
          "$.emergency": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.requiredSkillTags[0]": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.subcategoryId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
              }
            ]
          }
        }
      },
      "metaData": {
        "contentType": "application/json"
      },
      "providerStates": [
        {
          "name": "a booking has been created and is searching for a provider"
        }
      ]
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.6.21"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "dispatch-engine"
  }
}
