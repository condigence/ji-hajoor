{
  "consumer": {
    "name": "booking-service"
  },
  "interactions": [
    {
      "description": "a request for an itemised price estimate",
      "providerStates": [
        {
          "name": "a configured subcategory with pricing parameters"
        }
      ],
      "request": {
        "body": {
          "emergency": false,
          "subcategoryId": "22222222-2222-2222-2222-222222222222",
          "surgeActive": false
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.emergency": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.subcategoryId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.surgeActive": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "POST",
        "path": "/pricing/estimate"
      },
      "response": {
        "body": {
          "basePrice": 500.0,
          "couponAmount": 0.0,
          "demandSurgeCharge": 0.0,
          "discountAmount": 0.0,
          "distanceCharge": 50.0,
          "emergencyCharge": 0.0,
          "nightSurcharge": 0.0,
          "partsMaterialsCharge": 0.0,
          "platformFee": 55.0,
          "taxes": 99.0,
          "timeCharge": 0.0,
          "total": 704.0,
          "weekendSurcharge": 0.0
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.basePrice": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.couponAmount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.demandSurgeCharge": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.discountAmount": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.distanceCharge": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.emergencyCharge": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.nightSurcharge": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.partsMaterialsCharge": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.platformFee": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.taxes": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.timeCharge": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.total": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            },
            "$.weekendSurcharge": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "decimal"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.6.21"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "pricing-engine"
  }
}
