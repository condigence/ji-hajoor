<?xml version="1.0" encoding="UTF-8"?>
<!--
  promotion-service logging: reuse the shared structured-JSON base (Task 5) so every log line
  carries the mandatory fields (timestamp, serviceName, traceId, spanId, logLevel, message)
  and is PII-scrubbed. Coupon logs reference codes and IDs only, never customer PII
  (Requirement 26.4).
-->
<configuration>
    <property name="SERVICE_NAME" value="${spring.application.name:-promotion-service}"/>
    <include resource="logback-json-base.xml"/>
    <root level="INFO">
        <appender-ref ref="JSON_STDOUT"/>
    </root>
</configuration>
