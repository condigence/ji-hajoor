<?xml version="1.0" encoding="UTF-8"?>
<!--
  chat-service logging: reuse the shared structured-JSON base (Task 5) so every log line carries
  the mandatory fields (timestamp, serviceName, traceId, spanId, logLevel, message) and is
  PII-scrubbed. Chat message bodies and participant phone numbers are PII, so this service never
  logs message content, phone numbers, or device tokens (Requirement 26.4).
-->
<configuration>
    <property name="SERVICE_NAME" value="${spring.application.name:-chat-service}"/>
    <include resource="logback-json-base.xml"/>
    <root level="INFO">
        <appender-ref ref="JSON_STDOUT"/>
    </root>
</configuration>
