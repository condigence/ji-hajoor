<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jihajoor</groupId>
        <artifactId>jihajoor-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>com.jihajoor</groupId>
    <artifactId>chat-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Ji-Hajoor Chat Service</name>
    <description>
        In-app real-time chat between the Customer and Provider on a booking (Requirement 18).
        A chat channel is activated when a booking transitions to PROVIDER_ACCEPTED and deactivated
        on PAYMENT_COMPLETED or CANCELLED, both driven by idempotent Kafka consumption. Messages are
        delivered over WebSocket (under 1 s at up to 500 concurrent channels); offline recipients receive a
        push notification via the Notification Service within 10 s (modelled behind a vendor-neutral
        NotificationPushPort). Channel access is restricted to the two booking participants — every
        other principal receives 403 (Property 23). Personal phone numbers are masked in message
        bodies and never exposed. All messages are retained for at least 90 days from the booking's
        creation date regardless of channel status. Built on the shared security, observability, and
        outbox libraries (Tasks 4-6).
    </description>

    <dependencies>
        <!-- ===== Ji-Hajoor shared libraries (Tasks 4-6) ===== -->
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-resilience</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-outbox</artifactId>
        </dependency>
        <!-- Settings from the config.app_config table. -->
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-config</artifactId>
        </dependency>

        <!-- ===== Spring Boot starters ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <!-- Schema migrations: src/main/resources/db/migration/chat-service (V1 = baseline). -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- PostgreSQL support is a module of its own since Flyway 10. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== Kafka: consume ProviderAccepted / PaymentCompleted / BookingCancelled ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!-- ===== Runtime persistence driver ===== -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Micrometer Prometheus registry for /metrics (Requirement 25.4) ===== -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Test dependencies ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-memory DB for repository/integration slice tests -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- jqwik for property-based tests (Testing Strategy: Property-Based Tests) -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!-- JaCoCo coverage report (aligned with shared modules) -->
        </plugins>
    </build>
</project>
