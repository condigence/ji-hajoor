<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jihajoor</groupId>
        <artifactId>jihajoor-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <groupId>com.jihajoor</groupId>
    <artifactId>complaint-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Ji-Hajoor Complaint Service</name>
    <description>
        Complaint lifecycle, SLA enforcement, and refund coordination (Requirement 16). Creates
        complaint records against completed bookings with one of seven categories, a description up
        to 2000 characters, and up to 5 evidence attachments (each &lt;= 10 MB), and assigns the
        complaint to an available Support_Agent (16.1). Acknowledges the complaint to the customer
        via the Notification Service within 30 minutes (16.2) and notifies the customer of status
        changes via in-app notification within 5 minutes (16.3). Enforces resolution SLAs (24 h for
        emergency, 72 h for standard) escalating to a Senior_Support_Agent and notifying the
        customer on breach (16.4). Coordinates refunds with the Payment Service, setting
        REFUND_FAILED and alerting Finance_Admin on rejection (16.5, 16.6), places and releases
        provider settlement holds on DISPUTED/closed complaints (16.7, 16.8), and aggregates
        complaint statistics for Admin reports (16.9). Built on the shared security, observability,
        and outbox libraries (Tasks 4-6); coordinates with the Payment Service (Task 18) and the
        Booking Service (Task 14).
    </description>

    <dependencies>
        <!-- ===== Ji-Hajoor shared libraries (Tasks 4-6) ===== -->
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-resilience</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-outbox</artifactId>
        </dependency>
        <!-- Settings from the config.app_config table. -->
        <dependency>
            <groupId>com.jihajoor.shared</groupId>
            <artifactId>jihajoor-shared-config</artifactId>
        </dependency>

        <!-- ===== Spring Boot starters ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <!-- Schema migrations: src/main/resources/db/migration/complaint-service (V1 = baseline). -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- PostgreSQL support is a module of its own since Flyway 10. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== Runtime persistence driver ===== -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Micrometer Prometheus registry for /metrics (Requirement 25.4) ===== -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== Test dependencies ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
