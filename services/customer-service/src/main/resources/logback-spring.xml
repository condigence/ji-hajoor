<?xml version="1.0" encoding="UTF-8"?>
<!--
  customer-service logging: reuse the shared structured-JSON base (Task 5) so every log
  line carries the mandatory fields (timestamp, serviceName, traceId, spanId, logLevel,
  message) and is PII-scrubbed. This is critical here because the service handles
  customer PII (name, email, address) which must never reach logs (Requirement 26.4).
-->
<configuration>
    <property name="SERVICE_NAME" value="${spring.application.name:-customer-service}"/>
    <include resource="logback-json-base.xml"/>
    <root level="INFO">
        <appender-ref ref="JSON_STDOUT"/>
    </root>
</configuration>
