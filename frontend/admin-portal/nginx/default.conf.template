# admin-portal SPA + reverse proxy.
#
# This is an nginx *template*: at container start the official nginx image runs
# envsubst on it, filling in ${PORT}, ${NGINX_RESOLVER}, ${API_GATEWAY_URL} and
# ${AUTH_SERVICE_URL} (defaults live in docker-entrypoint.d/15-ji-hajoor-env.envsh).
# Only those names are substituted (NGINX_ENVSUBST_FILTER), so nginx's own
# $variables are left alone. Locally (docker compose) the defaults point at the
# compose service names; on Railway set API_GATEWAY_URL to the gateway's URL.
#
# The SPA's axios client uses baseURL="/api" and calls paths like
# "/auth/register/otp" and "/bookings/...". So the browser hits
# "/api/auth/register/otp". We strip only the leading "/api" and preserve the
# rest of the path so it maps to the service route (e.g. auth "/auth/register/otp",
# gateway "/bookings/**").
# The scheme the visitor actually used. Behind an edge proxy (Railway, an AWS
# ALB) TLS ends before nginx, so $scheme is "http"; passing that on would make
# the gateway's HTTPS enforcement answer every API call with a redirect.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen ${PORT};
    ${NGINX_LISTEN_V6}
    server_name _;

    # Railway's edge accepts plain http too and says so in X-Forwarded-Proto:
    # send those visitors to https. Requests without the header (health checks,
    # docker compose) are served as they are.
    if ($http_x_forwarded_proto = "http") {
        return 301 https://$host$request_uri;
    }

    # The container's own DNS server (read from /etc/resolv.conf at start-up):
    # Docker's embedded DNS locally, Railway's private-network DNS there.
    # Required for the variable-based proxy_pass below: nginx only re-resolves
    # an upstream when a resolver is configured.
    resolver ${NGINX_RESOLVER} valid=10s;
    root /usr/share/nginx/html;
    index index.html;

    # Baseline security headers. nginx only inherits add_header from an outer
    # level when the inner level declares none of its own, so every location
    # below that sets a header of its own repeats these three.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    # Compress text assets. The JS bundle is ~800 KB raw and ~250 KB gzipped, so
    # this is the single biggest win on first load.
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types
        application/javascript
        application/json
        application/manifest+json
        image/svg+xml
        text/css
        text/plain
        text/javascript;

    # Vite fingerprints asset filenames, so they can be cached forever; a new
    # build produces new names.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        try_files $uri =404;
    }

    # index.html must never be cached: it is what points at the current bundle.
    # Without this the browser keeps serving a stale shell that references the
    # previous build, and a redeploy appears to change nothing.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
    }

    # Auth calls go straight to the Auth Service, preserving the /auth prefix.
    # "/api/auth/register/otp" -> auth-service "/auth/register/otp".
    location /api/auth/ {
        # proxy_pass with a literal hostname is resolved once, at startup, and the
        # address is then cached for the life of the worker. Recreating a backend
        # container gives it a new IP, and every SPA 502s against the old one until
        # nginx is restarted -- which "docker compose up" triggers routinely.
        # Naming the upstream in a variable forces re-resolution against Docker's
        # embedded DNS, so a recreated backend is picked up within the TTL.
        set $auth_upstream ${AUTH_SERVICE_URL};
        rewrite ^/api/auth/(.*)$ /auth/$1 break;
        proxy_pass $auth_upstream;
        # The upstream's own host name: a Railway public domain is routed by Host.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # An https:// upstream needs SNI to get the right certificate.
        proxy_ssl_server_name on;
        # WebSocket (chat) and SSE (live location) both need HTTP/1.1 with the
        # Upgrade hop-by-hop headers forwarded, and response buffering off or
        # nginx holds each event until its buffer fills.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
    }

    # Everything else flows through the API Gateway, stripping only "/api".
    # "/api/bookings/123" -> gateway "/bookings/123".
    location /api/ {
        # Same re-resolution fix as /api/auth/ above.
        # Photo and document uploads are multipart requests of several MB. nginx
        # refuses any body over 1 MB by default with a 413 before the services'
        # own limits apply; booking-service accepts up to 60 MB per request.
        client_max_body_size 60m;
        set $gateway_upstream ${API_GATEWAY_URL};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $gateway_upstream;
        # The upstream's own host name: a Railway public domain is routed by Host.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # An https:// upstream needs SNI to get the right certificate.
        proxy_ssl_server_name on;
        # WebSocket (chat) and SSE (live location) both need HTTP/1.1 with the
        # Upgrade hop-by-hop headers forwarded, and response buffering off or
        # nginx holds each event until its buffer fills.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
    }

    # SPA history-mode fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}