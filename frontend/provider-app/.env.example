# Base path the SPA uses to reach the backend. In dev, requests to this path
# are handled by the Vite proxy (see vite.config.ts). Leave as "/api" for the
# proxied local setup.
VITE_API_BASE_URL=/api

# Local dev proxy targets (used only by the Vite dev server, not the browser).
VITE_API_GATEWAY_URL=http://localhost:8080
VITE_AUTH_SERVICE_URL=http://localhost:8081

# Google OAuth client id for Google Sign-In. Leave empty to keep the Google
# button disabled. It must be the SAME client id the Auth Service validates
# against (GOOGLE_CLIENT_ID in docker-compose.core.yml): the Auth Service checks
# the ID token's `aud` claim, so a mismatch is rejected.
VITE_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Native (Capacitor) builds — see frontend/MOBILE.md
# ---------------------------------------------------------------------------
# A native app has no reverse proxy and no origin of its own, so the relative
# "/api" above cannot resolve: the app would request itself. Every base URL must
# be absolute, and the app refuses to start otherwise (src/config/env.ts).
#
# Android emulator: 10.0.2.2 is the emulator's alias for the host machine.
# Physical device on the same Wi-Fi: use the host's LAN address (ipconfig).
# The API Gateway listens on 8080 and the Auth Service on 8081.
#
# VITE_API_BASE_URL=http://10.0.2.2:8080
# VITE_AUTH_BASE_URL=http://10.0.2.2:8081
#
# Physical device example:
# VITE_API_BASE_URL=http://192.168.1.20:8080
# VITE_AUTH_BASE_URL=http://192.168.1.20:8081
#
# Release builds must use https:// URLs; see the release checklist in MOBILE.md.
