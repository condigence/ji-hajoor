# HomeFix — local development environment template.
#
# LOCAL USE ONLY. Every value below is a throwaway placeholder that is safe to commit
# precisely because it is worthless: it must never be used in a shared, staging or
# production environment. Real deployments inject these from AWS Secrets Manager
# (see helm/ and infra/); nothing outside local dev should read this file.
#
# Usage:
#   cp .env.example .env
#   docker compose -f docker-compose.core.yml up -d --build
#
# docker-compose.core.yml declares these with the ${VAR:?...} form, so compose refuses
# to start — instead of silently falling back to a public secret — when one is missing.
# .env is git-ignored; .env.example is not. Keep both in step when adding a variable.

# ─── Required ────────────────────────────────────────────────────────────────────────

# Postgres superuser password, used both by the postgres container and by every
# service's spring.datasource.password.
DB_PASSWORD=homefix

# HMAC-SHA256 signing secret for platform access tokens, shared by the Auth Service
# (which signs) and every service's shared JwtValidationFilter (which verifies).
# Must be at least 32 bytes for HS256.
JWT_SECRET=local-dev-jwt-secret-please-change-32bytes-minimum

# Base64-encoded 256-bit AES data key for the local KMS adapter that encrypts provider
# and payment PII/instrument data (homefix.kms.data-key).
KMS_DATA_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Base64-encoded 256-bit AES data key for the Customer Service local KMS adapter that
# encrypts customer PII (homefix.kms.local-data-key).
KMS_LOCAL_DATA_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Payment gateway webhook signing secrets (HMAC-SHA256 over the raw callback payload).
# Locally no real gateway calls back, so any non-empty value works; in production these
# come from the gateway dashboards via Secrets Manager.
RAZORPAY_WEBHOOK_SECRET=local-dev-razorpay-webhook-secret
STRIPE_WEBHOOK_SECRET=local-dev-stripe-webhook-secret

# ─── Optional: Razorpay Checkout ─────────────────────────────────────────────────────
# Payments go through the local simulator unless these are set. To pay through Razorpay
# test mode, paste the key pair from Razorpay Dashboard > Account & Settings > API Keys
# (test mode, rzp_test_...) and switch the default gateway. Never commit real keys.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# PAYMENT_DEFAULT_GATEWAY=razorpay

# ─── Optional: social login ──────────────────────────────────────────────────────────
#
# Social login is optional. Leave a value empty and that provider is simply not offered:
# the Auth Service starts without it and a login attempt for it answers 401
# "unsupported provider". A provider is never enabled with a blank audience, because an
# unchecked 'aud' claim would accept any Google/Apple ID token issued for any app.

# Google OAuth client id. Must match VITE_GOOGLE_CLIENT_ID in frontend/*/.env.
GOOGLE_CLIENT_ID=

# Apple Services ID used as the 'aud' of Sign in with Apple identity tokens.
APPLE_SERVICES_ID=

# Shared credential the Dispatch Engine presents to the Booking Service on its
# /internal/** endpoints, and the Notification Service presents to the Auth Service's
# /internal/** contact lookup. Any sufficiently random string; it never leaves the cluster.
INTERNAL_API_KEY=local-dev-internal-service-key-change-me

# ─── Local test accounts ─────────────────────────────────────────────────────────────
#
# The Auth Service creates the accounts documented in docs/LOCAL_ACCESS.md at startup
# when this is enabled, each with a console username and the password below, so the
# Admin Portal can be signed in to on a fresh database. Staff roles are deliberately
# not self-assignable through registration, so without this a new stack has no account
# that can open the portal at all.
#
# Never enable this outside local development: it mints privileged accounts with a
# known password. The password has no default in the service, so an enabled seeder
# that is not given one logs an error and seeds nothing rather than inventing a value.
DEV_SEED_ENABLED=true
DEV_SEED_PASSWORD=HomeFix@2026
