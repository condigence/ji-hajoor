<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared JSON logging base for all HomeFix microservices.

  Include from a service's logback-spring.xml:

    <configuration>
      <property name="SERVICE_NAME" value="${spring.application.name:-unknown-service}"/>
      <include resource="logback-json-base.xml"/>
      <root level="INFO">
        <appender-ref ref="JSON_STDOUT"/>
      </root>
    </configuration>

  Mandatory JSON fields emitted on every line (Task 5 acceptance):
    - timestamp   ISO-8601 UTC
    - serviceName from ${SERVICE_NAME}
    - traceId     from MDC (OpenTelemetry logging appender / MDC instrumentation)
    - spanId      from MDC
    - logLevel    the log level
    - message     PII-scrubbed via PiiMaskingConverter

  Optional entity IDs (bookingId, userId, providerId, paymentId, correlationId)
  are emitted automatically when present on the MDC.
-->
<included>

    <!-- PII-scrubbing message converter (conversion word: piiMessage). -->
    <conversionRule conversionWord="piiMessage"
                    converterClass="com.homefix.shared.observability.logging.PiiMaskingConverter"/>

    <property name="SERVICE_NAME" value="${SERVICE_NAME:-unknown-service}"/>

    <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <!-- timestamp (ISO 8601, UTC) -->
                <timestamp>
                    <fieldName>timestamp</fieldName>
                    <timeZone>UTC</timeZone>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</pattern>
                </timestamp>

                <!-- logLevel -->
                <logLevel>
                    <fieldName>logLevel</fieldName>
                </logLevel>

                <!-- serviceName (static, from property) -->
                <pattern>
                    <pattern>{"serviceName":"${SERVICE_NAME}"}</pattern>
                </pattern>

                <!-- traceId / spanId sourced from MDC (populated by OTel MDC instrumentation) -->
                <mdc>
                    <includeMdcKeyName>trace_id</includeMdcKeyName>
                    <includeMdcKeyName>span_id</includeMdcKeyName>
                    <includeMdcKeyName>traceId</includeMdcKeyName>
                    <includeMdcKeyName>spanId</includeMdcKeyName>
                    <includeMdcKeyName>correlationId</includeMdcKeyName>
                    <includeMdcKeyName>bookingId</includeMdcKeyName>
                    <includeMdcKeyName>userId</includeMdcKeyName>
                    <includeMdcKeyName>providerId</includeMdcKeyName>
                    <includeMdcKeyName>paymentId</includeMdcKeyName>
                </mdc>

                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>

                <!-- message: run through PII scrubber before emission -->
                <pattern>
                    <pattern>{"message":"%piiMessage"}</pattern>
                </pattern>

                <!-- stack traces on exceptions, also PII-aware via shortenedThrowable -->
                <stackTrace>
                    <fieldName>stackTrace</fieldName>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

</included>
